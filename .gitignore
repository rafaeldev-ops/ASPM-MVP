# Config/estado local do Claude Code — não é parte do projeto.
.claude/

# Banco local da aplicação. Regenerado ao subir; guarda análises da máquina
# de quem rodou, incluindo nomes de arquivo de export reais.
sdip.db

# Scratch de renderização usado durante o desenvolvimento da interface.
_render/

# Regenerável a partir dos feeds públicos — nada aqui é entrada de nada.
phase0/.cache/
phase0/demo-*.csv
phase0/demo-*.json
phase0/decision-debt-report.html

__pycache__/
*.pyc
.venv/
venv/

.DS_Store
Thumbs.db

# --- Datasets do Ring 0 ---
# Os arquivos grandes sao regeneraveis e seus SHA-256 estao versionados em
# datasets/metadata/manifest.json -- e o hash que torna o run auditavel, nao o
# blob. Instrucoes de reconstrucao em datasets/README.md.
datasets/raw/*.zip
datasets/processed/codeql_emboss_findings.json

# Banco descartavel do benchmark de IA (o resultado versionado esta em evaluation/runs/).
evaluation/bench.db

# Empacotamento: gerado por packaging/build.py, nunca versionado.
dist/
build/
*.spec.bak
